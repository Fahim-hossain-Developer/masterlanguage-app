// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  PENDING_VERIFICATION
}

enum TrackType {
  FOUNDATION_A1
  FOUNDATION_A2
  INTERMEDIATE_B1
  UPPER_INTERMEDIATE_B2
  ADVANCED_C1
  IELTS_ACADEMIC
  IELTS_GENERAL
  SPOKEN_ENGLISH
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum ContentType {
  VIDEO
  AUDIO
  TEXT
  QUIZ
  INTERACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  FLAGGED
}

enum QuestionType {
  MCQ
  TRUE_FALSE_NG
  YES_NO_NG
  MATCHING_HEADING
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
  SHORT_ANSWER
  MAP_LABELING
  DIAGRAM_LABELING
  FILL_IN_BLANKS
  ERROR_CORRECTION
  REORDER
}

enum IELTSSkill {
  READING
  LISTENING
  WRITING
  SPEAKING
}

enum FoundationSkill {
  GRAMMAR
  VOCABULARY
  PRONUNCIATION
  CONVERSATION
  READING
  LISTENING
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  phone           String?    @unique
  passwordHash    String
  role            Role       @default(STUDENT)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile               Profile?
  refreshTokens         RefreshToken[]
  subscription          Subscription?
  payments              Payment[]
  testAttempts          TestAttempt[]
  lessonProgress        LessonProgress[]
  aiEvaluations         AIEvaluation[]
  studyPlans            StudyPlan[]
  studyStreak           StudyStreak?
  xpLedger              XPLedger[]
  userAchievements      UserAchievement[]
  srsCards              SRSCard[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  placementResults      PlacementResult[]
  conversationSessions  AIConversationSession[]
  createdCourses        Course[]          @relation("CourseCreator")

  @@map("users")
}

model Profile {
  id                     String     @id @default(uuid())
  userId                 String     @unique
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String
  avatarUrl              String?
  bio                    String?
  currentCEFR            CEFRLevel? @default(A1)
  targetTrack            TrackType? @default(IELTS_ACADEMIC)
  targetBand             Float?     @default(7.5)
  examDate               DateTime?
  nationality            String?    @default("Bangladeshi")
  timezone               String     @default("Asia/Dhaka")
  nativeLanguage         String?    @default("Bengali")
  studyGoalMinutesPerDay Int        @default(30)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@map("profiles")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  deviceInfo String?
  ipAddress  String?
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// SUBSCRIPTIONS & PAYMENTS
// ─────────────────────────────────────────────

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  descriptionEn String?
  descriptionBn String?
  priceBDT      Decimal  @db.Decimal(10, 2)
  priceUSD      Decimal  @db.Decimal(10, 2)
  features      Json
  durationDays  Int
  isActive      Boolean  @default(true)
  trialDays     Int      @default(0)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id          String             @id @default(uuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        SubscriptionPlan   @relation(fields: [planId], references: [id])
  status      SubscriptionStatus @default(TRIAL)
  startsAt    DateTime           @default(now())
  expiresAt   DateTime
  autoRenew   Boolean            @default(true)
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("BDT")
  gateway        String        // bKash, Nagad, SSLCommerz, Stripe
  gatewayTxnId   String?       @unique
  status         PaymentStatus @default(PENDING)
  receiptUrl     String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("payments")
}

// ─────────────────────────────────────────────
// COURSES, MODULES & LESSONS
// ─────────────────────────────────────────────

model Course {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  descriptionEn String
  descriptionBn String?
  trackType     TrackType
  cefrLevel     CEFRLevel?
  thumbnailUrl  String?
  trailerUrl    String?
  totalDuration Int       @default(0)
  isPublished   Boolean   @default(false)
  isFree        Boolean   @default(false)
  createdById   String
  createdBy     User      @relation("CourseCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  modules Module[]

  @@map("courses")
}

model Module {
  id            String   @id @default(uuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  descriptionEn String?
  descriptionBn String?
  orderIndex    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id            String      @id @default(uuid())
  moduleId      String
  module        Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String
  contentType   ContentType
  contentUrl    String?
  textContent   String?
  duration      Int         @default(0)
  orderIndex    Int
  isFree        Boolean     @default(false)
  isPublished   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  progress LessonProgress[]

  @@map("lessons")
}

model LessonProgress {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  watchDuration Int       @default(0)
  lastPosition  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ─────────────────────────────────────────────
// DIAGNOSTIC & PLACEMENT TEST
// ─────────────────────────────────────────────

model PlacementTest {
  id              String              @id @default(uuid())
  title           String
  description     String
  durationMinutes Int                 @default(25)
  totalQuestions  Int                 @default(30)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  questions PlacementQuestion[]
  results   PlacementResult[]

  @@map("placement_tests")
}

model PlacementQuestion {
  id             String        @id @default(uuid())
  testId         String
  test           PlacementTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionNumber Int
  targetCEFR     CEFRLevel
  skill          FoundationSkill
  questionText   String
  options        Json          // [{ label, text }]
  correctAnswer  String
  explanationEn  String?
  explanationBn  String?
  createdAt      DateTime      @default(now())

  @@map("placement_questions")
}

model PlacementResult {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId           String
  test             PlacementTest @relation(fields: [testId], references: [id])
  evaluatedCEFR    CEFRLevel
  predictedBand    Float
  recommendedTrack TrackType
  grammarScore     Int
  vocabScore       Int
  listeningScore   Int
  readingScore     Int
  breakdownScores  Json
  timeSpentSeconds Int           @default(0)
  createdAt        DateTime      @default(now())

  @@map("placement_results")
}

// ─────────────────────────────────────────────
// FOUNDATION: GRAMMAR LAB
// ─────────────────────────────────────────────

model GrammarTopic {
  id            String      @id @default(uuid())
  level         CEFRLevel
  title         String
  slug          String      @unique
  summaryEn     String
  summaryBn     String?
  contentEn     String      // Full markdown lesson
  contentBn     String?     // Optional Bengali translation
  ruleExamples  Json        // [{ rule, example, translation }]
  commonErrors  Json?       // [{ incorrect, correct, explanation }]
  orderIndex    Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  exercises GrammarExercise[]

  @@map("grammar_topics")
}

model GrammarExercise {
  id            String       @id @default(uuid())
  topicId       String
  topic         GrammarTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionType  QuestionType
  prompt        String
  options       Json?
  correctAnswer String
  explanationEn String?
  explanationBn String?
  marks         Int          @default(1)
  createdAt     DateTime     @default(now())

  @@map("grammar_exercises")
}

// ─────────────────────────────────────────────
// FOUNDATION: SMART VOCABULARY & SRS
// ─────────────────────────────────────────────

model EnglishVocabulary {
  id                 String    @id @default(uuid())
  word               String    @unique
  phonetic           String?
  partOfSpeech       String
  level              CEFRLevel
  definitionEn       String
  definitionBn       String?
  exampleSentence    String
  exampleTranslation String?
  collocations       String[]
  synonyms           String[]
  antonyms           String[]
  audioUrl           String?
  isAcademicWordList Boolean   @default(false)
  createdAt          DateTime  @default(now())

  srsCards SRSCard[]

  @@map("english_vocabulary")
}

model SRSCard {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabId        String
  vocab          EnglishVocabulary @relation(fields: [vocabId], references: [id], onDelete: Cascade)
  easeFactor     Float             @default(2.5)
  intervalDays   Int               @default(1)
  repetitions    Int               @default(0)
  dueAt          DateTime          @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime          @default(now())

  @@unique([userId, vocabId])
  @@map("srs_cards")
}

// ─────────────────────────────────────────────
// FOUNDATION: AI CONVERSATION & ROLEPLAY
// ─────────────────────────────────────────────

model AIConversationScenario {
  id             String    @id @default(uuid())
  title          String
  scenarioType   String    // Daily, Business, IELTS Speaking
  targetLevel    CEFRLevel
  systemPrompt   String
  initialGreeting String
  objectives     String[]
  iconUrl        String?
  createdAt      DateTime  @default(now())

  sessions AIConversationSession[]

  @@map("ai_conversation_scenarios")
}

model AIConversationSession {
  id          String                  @id @default(uuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId  String?
  scenario    AIConversationScenario? @relation(fields: [scenarioId], references: [id])
  scenarioName String
  messages    Json                    // [{ role: 'user'|'assistant', content: string, timestamp: string }]
  feedback    Json?                   // { grammarIssues, vocabularySuggestions, fluencyScore }
  durationSec Int                     @default(0)
  isCompleted Boolean                 @default(false)
  createdAt   DateTime                @default(now())

  @@map("ai_conversation_sessions")
}

// ─────────────────────────────────────────────
// IELTS TEST ENGINE
// ─────────────────────────────────────────────

model IELTSTest {
  id               String     @id @default(uuid())
  title            String
  trackType        TrackType  @default(IELTS_ACADEMIC)
  skill            IELTSSkill
  durationMinutes  Int
  totalQuestions   Int        @default(0)
  isOfficialFormat Boolean    @default(false)
  isPublished      Boolean    @default(false)
  difficultyLevel  String     @default("intermediate")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  passages  TestPassage[]
  questions TestQuestion[]
  attempts  TestAttempt[]

  @@map("ielts_tests")
}

model TestPassage {
  id            String    @id @default(uuid())
  testId        String
  test          IELTSTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  passageNumber Int
  title         String?
  content       String
  wordCount     Int       @default(0)
  audioUrl      String?
  createdAt     DateTime  @default(now())

  questions TestQuestion[]

  @@map("test_passages")
}

model TestQuestion {
  id             String        @id @default(uuid())
  testId         String
  test           IELTSTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  passageId      String?
  passage        TestPassage?  @relation(fields: [passageId], references: [id])
  questionNumber Int
  questionType   QuestionType
  questionText   String
  options        Json?
  correctAnswer  String
  explanationEn  String?
  explanationBn  String?
  marks          Int           @default(1)
  createdAt      DateTime      @default(now())

  answers AttemptAnswer[]

  @@map("test_questions")
}

model TestAttempt {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  testId             String
  test               IELTSTest     @relation(fields: [testId], references: [id])
  status             AttemptStatus @default(IN_PROGRESS)
  startedAt          DateTime      @default(now())
  submittedAt        DateTime?
  bandScore          Float?
  sectionScores      Json?
  flaggedForCheating Boolean       @default(false)
  warningCount       Int           @default(0)
  ipAddress          String?
  createdAt          DateTime      @default(now())

  answers      AttemptAnswer[]
  aiEvaluation AIEvaluation?

  @@map("test_attempts")
}

model AttemptAnswer {
  id               String       @id @default(uuid())
  attemptId        String
  attempt          TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         TestQuestion @relation(fields: [questionId], references: [id])
  userAnswer       String?
  isCorrect        Boolean?
  timeSpentSeconds Int          @default(0)
  createdAt        DateTime     @default(now())

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

model AIEvaluation {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  attemptId     String?      @unique
  attempt       TestAttempt? @relation(fields: [attemptId], references: [id])
  evalType      String       // writing_task1, writing_task2, speaking
  inputRef      String?      // Essay text or audio URL
  modelUsed     String       // gemini-1.5-pro
  promptVersion String       @default("v2")
  rawResponse   String?
  parsedScores  Json?        // { taskAchievement: 7, coherence: 6.5, lexical: 7, grammar: 6, overall: 6.5 }
  feedbackText  String?      // Markdown detailed breakdown
  improvements  Json?        // [{ original: "", improved: "", reason: "" }]
  processingMs  Int?
  status        String       @default("pending")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("ai_evaluations")
}

// ─────────────────────────────────────────────
// STUDY & PLANNING
// ─────────────────────────────────────────────

model StudyPlan {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCEFR  CEFRLevel @default(B2)
  targetBand  Float     @default(7.0)
  examDate    DateTime
  planData    Json      // Daily schedule, tasks, milestones
  isActive    Boolean   @default(true)
  generatedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("study_plans")
}

// ─────────────────────────────────────────────
// GAMIFICATION
// ─────────────────────────────────────────────

model Achievement {
  id            String   @id @default(uuid())
  name          String
  description   String
  iconUrl       String?
  criteriaType  String
  criteriaValue Int
  xpReward      Int      @default(0)
  createdAt     DateTime @default(now())

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model StudyStreak {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("study_streaks")
}

model XPLedger {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  reason      String
  referenceId String?
  createdAt   DateTime @default(now())

  @@map("xp_ledger")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}
