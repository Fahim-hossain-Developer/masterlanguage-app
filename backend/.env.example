# ================================
# MasterLanguage Backend — Environment Variables
# ================================
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/masterlanguage

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=masterlanguage-media

# AI
GEMINI_API_KEY=

# CORS
FRONTEND_URL=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# PgAdmin (Docker)
PGADMIN_DEFAULT_EMAIL=admin@masterlanguage.io
PGADMIN_DEFAULT_PASSWORD=admin123
